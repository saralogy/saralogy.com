---
import Base from "@layouts/Base.astro";
import "../styles/global.css";

const img = (n) => "/images/industrial-design-portfolio/page-" + String(n).padStart(2, "0") + ".jpg";
const titles = ["Portfolio cover","A note on staying curious","Contact","Guru — product study","Guru — sketches and ideas","Guru — form development","Guru — handle and screen studies","Guru — user context","Guru — research insights","Guru — usage scenarios","Guru — form research","Guru — concept development","Guru — finalization","Guru — interface wireframes","Guru — prototypes","Guru — product catalog","Guru — catalog study","Guru — catalog study","Guru — catalog study","Guru — final catalog","Graduation projects exhibition","Neosteam — steam iron","Neosteam — product analysis","Neosteam — ergonomics and concepts","Neosteam — final concept","T-Express — tea machine","T-Express — design process","T-Express — final features","Monjam — jam jar","Monjam — first phase","Tea brewing set — second phase","Tobogga — two-person sled","Tobogga — making and finalization","Vo Mangal — barbecue set","Vo Mangal — visual identity","Vo Mangal — design process","Vo Mangal — drawings","Graduation poster design","Graduation poster design","Graduation exhibition","Thank you"];
const projects = [
  { n:"01", name:"Guru", type:"Multi-cooker", year:"2013—14", pages:"04—20", start:4, cover:13, desc:"A kitchen companion shaped around everyday cooking rituals, clear controls and a more intuitive experience." },
  { n:"02", name:"Neosteam", type:"Steam iron", year:"2012", pages:"22—25", start:22, cover:25, desc:"A confident, ergonomic iron developed through product analysis, anthropometric research and hands-on foam models." },
  { n:"03", name:"T-Express", type:"Tea machine", year:"2013", pages:"26—28", start:26, cover:28, desc:"A compact tea maker for busy mornings, with instant or delayed brewing and a removable brewing part." },
  { n:"04", name:"Monjam", type:"Jam jar", year:"2012", pages:"29—30", start:29, cover:30, desc:"A glass package with a second life, exploring how a clear zero-sugar concept could continue beyond the shelf." },
  { n:"05", name:"Tea brewing set", type:"Reuse / glass", year:"2012", pages:"31", start:31, cover:31, desc:"A post-use glass packaging concept reimagined as a tea set with ceramic cups and protective felt." },
  { n:"06", name:"Tobogga", type:"Two-person sled", year:"2011", pages:"32—33", start:32, cover:33, desc:"A two-person sled designed around approachable making and practical ways to shape wood." },
  { n:"07", name:"Vo Mangal", type:"Barbecue set", year:"2011", pages:"34—37", start:34, cover:36, desc:"A patio barbecue system bringing cooking, shade, storage and a coordinated visual identity together." },
  { n:"08", name:"Graduation posters", type:"Graphic design", year:"2014", pages:"38—40", start:38, cover:39, desc:"A visual study of the iconic Turkish tea glass, connecting its curves with METU and the design studio." },
];
const pages = Array.from({ length:41 }, (_, i) => i + 1);
const additional = [
  { group:"Retail & product presentation · 2017", title:"Samsung brand stores", meta:"Retail design · Turkey", image:"2017-p03.jpg", alt:"Samsung brand store design and retail display", desc:"Retail strategy and store development across Samsung’s national brand store rollout. 150 stores had opened by 2018." },
  { group:"Retail & product presentation · 2017", title:"Marmara Forum", meta:"Samsung Brand Store · Istanbul", image:"2017-p07.jpg", alt:"Samsung Brand Store at Marmara Forum Mall, Istanbul", desc:"A Samsung brand store designed for Istanbul’s Marmara Forum Mall in 2017." },
  { group:"Retail & product presentation · 2017", title:"Chef Collection showcase", meta:"Premium kitchen · 10 locations", image:"2017-p09.jpg", alt:"Samsung Chef Collection premium kitchen showcase", desc:"Premium kitchen displays produced for 10 special locations in Turkey, completed in one month." },
  { group:"Retail & product presentation · 2017", title:"Vault footwear stand", meta:"Freelance · footwear retail", image:"2017-p12.jpg", alt:"Vault footwear display stand design", desc:"Freelance footwear stand concept and display design for Vault." },
  { group:"Freelance & visual design · 2016", title:"Book cover", meta:"Editorial design · Y. N. Anginer", image:"freelance2016-p02.jpg", alt:"Book cover design for writer Y. N. Anginer", desc:"Cover design developed for writer Y. N. Anginer." },
  { group:"Freelance & visual design · 2016", title:"Corporate identities", meta:"Logo design · furniture & roofing", image:"freelance2016-p03.jpg", alt:"Corporate logo design concepts for furniture and roofing companies", desc:"Identity concepts for furniture and roof manufacturing businesses." },
  { group:"Freelance & visual design · 2016", title:"Esprit leather labels", meta:"Label design · Stitch & Trim", image:"freelance2016-p05.jpg", alt:"Leather label design concepts for Esprit", desc:"Leather label concepts for Esprit, developed for Stitch & Trim." },
  { group:"Freelance & visual design · 2016", title:"Ilkler Çatı", meta:"Identity & website", image:"freelance2016-p07.jpg", alt:"Ilkler Cati corporate identity and website", desc:"Corporate identity and website design for Ilkler Çatı." },
  { group:"Freelance & visual design · 2016", title:"ORS", meta:"Corporate website · agency project", image:"freelance2016-p08.jpg", alt:"ORS corporate website design", desc:"Corporate website design for ORS, completed through a local agency." },
  { group:"Freelance & visual design · 2016", title:"Park Hayat Ankara", meta:"Corporate website · agency project", image:"freelance2016-p09.jpg", alt:"Park Hayat Ankara corporate website design", desc:"Corporate website design for Park Hayat Ankara, completed through a local agency." },
  { group:"Freelance & visual design · 2016", title:"ORMA website", meta:"Corporate website · freelance", image:"freelance2016-p11.jpg", alt:"ORMA corporate website design", desc:"Website design completed alongside the formal role scope." },
  { group:"Freelance & visual design · 2016", title:"ORMA careers", meta:"Career landing page · freelance", image:"freelance2016-p12.jpg", alt:"ORMA corporate career landing page", desc:"A dedicated career landing page, completed alongside the formal role scope." },
  { group:"Freelance & visual design · 2016", title:"ORMA graduate catalog", meta:"Editorial design · freelance", image:"freelance2016-p13.jpg", alt:"ORMA catalog for young graduates", desc:"A corporate catalog for young graduates, completed alongside the formal role scope." },
];
---

<Base title="Industrial Design Portfolio | Berk Saraloglu" description="Selected industrial design work by Berk Saraloglu, developed at METU between 2011 and 2014." ogImage={img(13)} noIndex={false} canonicalUrl="https://saralogy.com/industrial-design-portfolio">
<main class="portfolio">
  <header class="nav"><a href="/" class="brand"><b>BS</b><span>Berk Saraloglu</span></a><nav><a href="#projects">Selected work</a><a href="#professional-work">Professional work</a><a href="#archive">Full archive</a><a class="contact" href="mailto:berksaraloglu@gmail.com">Get in touch ↗</a></nav></header>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><i></i> Industrial design · METU · 2011—2014</p>
      <h1>Designing the<br><em>everyday.</em></h1>
      <p class="lead">Before I shaped stories for brands, I shaped the objects people live with. A selection of projects exploring useful forms, thoughtful details and the rituals around them.</p>
      <div class="actions"><a class="button dark" href="#projects">Explore the work <span>↓</span></a><button class="text-button" data-open-page="1">Open the portfolio ↗</button></div>
      <div class="stats"><span>8 selected projects</span><b></b><span>41 portfolio pages</span><b></b><span>Ankara, Türkiye</span></div>
    </div>
    <div class="hero-art"><button class="hero-image" data-open-page="4" aria-label="Open Guru product study"><img src={img(4)} alt="Guru multi-cooker product study from the portfolio" fetchpriority="high" /><span>01 / 08</span></button><div class="stamp"><small>Form follows</small><strong>feeling.</strong><small>METU · 2011</small></div><div class="caption"><b>01 — GURU</b><span>Product design study</span></div></div>
  </section>
  <section class="intro"><small>A design education</small><p>A curiosity-led practice: observe how people live, make ideas tangible, then refine until the product feels simple.</p><button data-open-page="5">See the process ↗</button></section>
  <section id="projects" class="projects">
    <div class="heading"><div><p class="eyebrow">Selected work <span>— 2011 to 2014</span></p><h2>Objects, ideas<br>and their afterlives.</h2></div><p>From small kitchen rituals to outdoor gatherings, each project began with a question about how a product could work harder for the people who use it.</p></div>
    <div class="grid">{projects.map((p) => <article class="card"><button class="cover" data-open-page={p.start} aria-label={"Open " + p.name + " project"}><img src={img(p.cover)} alt={p.name + ", " + p.type + " — portfolio page " + p.cover} loading="lazy"><span class="pageno">P. {p.pages}</span><span class="zoom">↗</span></button><div class="meta"><span>{p.n} / {p.type}</span><span>{p.year}</span></div><h3>{p.name}</h3><p>{p.desc}</p><button class="open-link" data-open-page={p.start}>Explore project <b>→</b></button></article>)}</div>
  </section>
  <section class="additional-work" id="professional-work">
    <div class="heading"><div><p class="eyebrow">Beyond the student portfolio <span>— 2016 & 2017</span></p><h2>Design work in<br>the wider world.</h2></div><p>Retail environments, product presentation and freelance visual work, selected from two later portfolios.</p></div>
    <div class="store-note"><span class="store-number">150</span><p><b>Samsung brand stores opened across Turkey by 2018.</b><br>My role covered retail strategy, design coordination and production rollout.</p></div>
    <div class="additional-grid">{additional.map((item) => <article class="additional-card"><button class="additional-image" data-image={"/images/industrial-design-portfolio/additional/" + item.image} data-alt={item.alt} data-title={item.title} aria-label={"View " + item.title}><img src={"/images/industrial-design-portfolio/additional/" + item.image} alt={item.alt} loading="lazy"><span>View image ↗</span></button><p class="additional-group">{item.group}</p><h3>{item.title}</h3><p class="additional-meta">{item.meta}</p><p class="additional-desc">{item.desc}</p></article>)}</div>
  </section>
  <section class="process"><div class="process-label"><span>01—04</span> How I worked</div><div class="steps"><article><small>01</small><h3>Observe</h3><p>Start with people, context and everyday frictions.</p></article><article><small>02</small><h3>Explore</h3><p>Use sketching and form studies to open directions.</p></article><article><small>03</small><h3>Make</h3><p>Build quick models to test ergonomics and feel.</p></article><article><small>04</small><h3>Refine</h3><p>Bring the strongest idea into a considered form.</p></article></div><small class="note">A process visible throughout the portfolio</small></section>
  <section id="archive" class="archive"><div class="heading"><div><p class="eyebrow">The complete portfolio <span>— 41 pages</span></p><h2>Look a little closer.</h2></div><p>Browse the original portfolio page by page. Select any spread to open the immersive viewer.</p></div><div class="archive-bar"><span><b>41</b> pages <i>/</i> 8 projects</span><button data-open-page="1">Start from the cover ↗</button></div><div class="pages">{pages.map((n) => <button class="page" data-open-page={n} aria-label={"Open page " + n + ": " + titles[n-1]}><span class="thumb"><img src={img(n)} alt="" loading="lazy"></span><span class="page-caption"><b>{String(n).padStart(2,"0")}</b><span>{titles[n-1]}</span></span></button>)}</div></section>
  <section class="closing"><div class="orbit o1"></div><div class="orbit o2"></div><div class="orbit o3"></div><div class="closing-copy"><p class="eyebrow">A practice that keeps evolving</p><h2>Still curious.<br><em>Still making.</em></h2><p>Industrial design taught me to look closely, question assumptions and care about the details. I carry that same instinct into everything I build today.</p><a class="button light" href="mailto:berksaraloglu@gmail.com">Say hello ↗</a></div><small class="closing-mark">BS · 2011—2026</small></section>
  <footer class="footer"><a href="/" class="brand"><b>BS</b><span>Berk Saraloglu</span></a><p>Industrial Design Portfolio · 2011—2014</p><div><a href="/about">About</a><a href="mailto:berksaraloglu@gmail.com">Contact</a><a href="#top">Back to top ↑</a></div></footer>
</main>
<dialog class="viewer" aria-label="Portfolio page viewer"><div class="viewer-top"><span class="brand"><b>BS</b> Industrial Design Portfolio</span><span class="vtitle" id="vtitle">Portfolio cover <i id="vcount">01 / 41</i></span><button class="close" aria-label="Close viewer">×</button></div><div class="stage"><button class="arrow prev" aria-label="Previous page">←</button><img class="spread" src={img(1)} alt="Portfolio cover, page 1 of 41"><button class="arrow next" aria-label="Next page">→</button></div><div class="viewer-bottom"><span>BERK SARALOGLU / INDUSTRIAL DESIGN</span><div class="progress"><i></i></div><span>2011—2014</span></div></dialog>
<dialog class="image-viewer" aria-label="Selected work image"><button class="image-close" aria-label="Close image">×</button><img class="selected-image" alt=""><p class="selected-caption"></p></dialog>
</Base>
<style>
:global(html){scroll-behavior:smooth;background:#f7f6f2}:global(body){background:#f7f6f2}
.portfolio{--paper:#f7f6f2;--ink:#161918;--muted:#727971;--line:#deded7;--blue:#526d73;color:var(--ink);overflow:hidden}
.nav{height:76px;padding:0 6.25vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #16191815;position:relative;z-index:2}
.brand{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font-size:12px;font-weight:600}.brand b{width:28px;height:28px;display:grid;place-items:center;border:1px solid currentColor;font-size:9px;letter-spacing:-.08em}
.nav nav{display:flex;align-items:center;gap:34px}.nav nav a,.footer a{font-size:10px;text-decoration:none;color:inherit}.nav nav a:hover,.footer a:hover{color:var(--blue)}.nav .contact{padding:11px 15px;background:var(--ink);color:white}
.hero{min-height:min(680px,calc(100svh - 76px));padding:68px 10vw 78px 12.5vw;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:6vw;position:relative;background:radial-gradient(ellipse at 78% 50%,#e0e7e3 0,transparent 40%),linear-gradient(110deg,#f7f6f2,#f0f1ec)}
.hero-copy{max-width:570px}.eyebrow{display:flex;align-items:center;gap:9px;color:#69766f;text-transform:uppercase;font:600 9px/1.4 var(--font-body);letter-spacing:.16em}.eyebrow i{width:6px;height:6px;border-radius:50%;background:#738b83;box-shadow:0 0 0 4px #738b831f}.hero h1,.heading h2,.closing h2{font:400 clamp(56px,7.4vw,102px)/.92 Georgia,serif;letter-spacing:-.06em}.hero h1{margin:33px 0 20px}.hero h1 em,.closing h2 em{color:var(--blue);font-weight:400}.lead{max-width:420px;color:#626862;font-size:13px;line-height:1.9}.actions{display:flex;align-items:center;gap:24px;margin-top:27px}.button{display:inline-flex;align-items:center;gap:18px;padding:14px 17px;text-decoration:none;text-transform:uppercase;font-size:9px;font-weight:600;letter-spacing:.09em;transition:.2s}.button:hover{transform:translateY(-2px)}.dark{color:white;background:var(--ink)}.dark:hover{background:#354340}.text-button,.intro button,.open-link,.archive-bar button{border:0;padding:0;background:none;color:var(--ink);cursor:pointer;font:600 9px var(--font-body);letter-spacing:.06em;text-transform:uppercase}.text-button:hover,.intro button:hover,.open-link:hover,.archive-bar button:hover{color:var(--blue)}.stats{display:flex;align-items:center;gap:10px;margin-top:39px;color:#81857e;font-size:8px;letter-spacing:.07em;text-transform:uppercase}.stats b{width:3px;height:3px;border-radius:50%;background:#a5aaa2}
.hero-art{position:relative;max-width:490px;width:100%;justify-self:center}.hero-image{display:block;position:relative;width:100%;aspect-ratio:4/4.55;padding:0;overflow:hidden;border:0;background:#232728;cursor:pointer;box-shadow:0 22px 55px #232c2a22}.hero-image img{width:100%;height:100%;display:block;object-fit:cover}.hero-image span{position:absolute;bottom:13px;right:14px;color:white;font-size:8px;letter-spacing:.12em}.stamp{position:absolute;left:-53px;bottom:15%;width:124px;height:124px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#e8e7df;border:1px solid #c8cac1;color:var(--blue);transform:rotate(-12deg);box-shadow:0 8px 30px #2222}.stamp small{font-size:7px;letter-spacing:.08em;text-transform:uppercase}.stamp strong{font:italic 22px Georgia,serif}.caption{display:flex;justify-content:space-between;padding-top:12px;color:#747b75;font-size:8px;letter-spacing:.1em;text-transform:uppercase}.caption b{color:var(--ink)}.intro{min-height:110px;padding:24px 12.5vw;display:grid;grid-template-columns:.65fr 1.6fr .7fr;gap:25px;align-items:center;background:#f0f1ec;border-block:1px solid #16191812}.intro small{color:#748078;font-size:8px;font-weight:600;text-transform:uppercase;letter-spacing:.16em}.intro p{margin:0;color:#4e5550;font:italic 19px/1.45 Georgia,serif}.intro button{justify-self:end}
.projects,.archive{padding:116px 12.5vw 125px}.heading{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:48px}.heading .eyebrow{margin:0 0 18px}.heading .eyebrow span{color:#a0a49e;font-weight:400}.heading h2{margin:0;font-size:clamp(43px,5.3vw,68px);line-height:.98}.heading>p{max-width:300px;margin:0 0 5px;color:#767b75;font-size:11px;line-height:1.9}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:62px 34px}.card:nth-child(even){transform:translateY(66px)}.cover{display:block;position:relative;width:100%;aspect-ratio:1.6/1;padding:0;overflow:hidden;border:0;background:#e5e4dc;text-align:left;cursor:pointer}.cover img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .55s}.cover:hover img{transform:scale(1.035)}.pageno{position:absolute;bottom:12px;left:13px;padding:6px 8px;background:#111c;color:white;font-size:8px;letter-spacing:.1em}.zoom{position:absolute;top:13px;right:13px;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#f7f6f2e8;opacity:0;transition:.2s}.cover:hover .zoom,.cover:focus-visible .zoom{opacity:1}.meta{display:flex;justify-content:space-between;margin-top:16px;color:#80867e;font-size:8px;letter-spacing:.13em;text-transform:uppercase}.card h3{margin:11px 0 6px;font:400 29px Georgia,serif}.card>p{max-width:410px;min-height:39px;margin:0;color:#737971;font-size:10px;line-height:1.8}.open-link{margin-top:17px;font-size:8px}.open-link b{padding-left:8px;font-size:14px}
.process{position:relative;padding:50px 12.5vw 61px;background:#e8ebe5}.process-label{display:flex;gap:14px;color:#68766e;font-size:8px;text-transform:uppercase;letter-spacing:.15em}.process-label span{color:#9ba69e}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;margin-top:38px}.steps article{border-top:1px solid #c7cec5;padding-top:12px}.steps small{color:#8a978f;font-size:8px}.steps h3{margin:10px 0 6px;font:400 24px Georgia,serif}.steps p{max-width:210px;margin:0;color:#6f7871;font-size:9px;line-height:1.8}.note{position:absolute;right:12.5vw;top:52px;color:#879087;font-size:8px;letter-spacing:.07em}
.archive{background:var(--paper)}.archive .heading{margin-bottom:40px}.archive-bar{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-block:1px solid var(--line);color:#7c827c;font-size:9px;letter-spacing:.06em}.archive-bar b{color:var(--ink)}.archive-bar i{margin:0 10px;color:#c0c2bb;font-style:normal}.pages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:23px 14px;margin-top:23px}.page{border:0;padding:0;background:none;color:var(--ink);text-align:left;cursor:pointer;min-width:0}.thumb{display:block;aspect-ratio:1.42/1;overflow:hidden;background:#e9e8e1}.thumb img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .35s}.page:hover .thumb img{transform:scale(1.045)}.page-caption{display:flex;gap:9px;align-items:baseline;padding-top:9px}.page-caption b{color:#6b8076;font-size:8px;letter-spacing:.08em}.page-caption span{overflow:hidden;color:#83877f;font-size:8px;white-space:nowrap;text-overflow:ellipsis}
.closing{position:relative;overflow:hidden;background:#202827;color:#f7f6f2}.closing-copy{position:relative;z-index:1;padding:110px 0 120px 17vw;max-width:740px}.closing .eyebrow{color:#a5b5ac}.closing h2{margin:28px 0 22px;font-size:clamp(58px,7vw,90px)}.closing h2 em{color:#a4b4a9}.closing-copy>p:not(.eyebrow){max-width:390px;margin:0 0 24px;color:#bac2bb;font-size:11px;line-height:1.9}.light{background:#e5e8df;color:#1b2421}.light:hover{background:#fff}.orbit{position:absolute;border:1px solid #d0dcd21f;border-radius:50%;aspect-ratio:1}.o1{width:670px;right:-8%;top:-290px}.o2{width:510px;right:0;top:-210px}.o3{width:350px;right:9%;top:-130px}.closing-mark{position:absolute;bottom:27px;right:6vw;color:#849089;font-size:8px;letter-spacing:.15em}.footer{min-height:82px;padding:20px 6.25vw;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#202827;color:#c1c7c2;border-top:1px solid #343b39}.footer p{margin:0;color:#929b94;font-size:8px;letter-spacing:.08em}.footer>div{display:flex;gap:22px}.footer>div a{font-size:8px}
.viewer{width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;background:#111615;color:#f5f5f1}.viewer::backdrop{background:#101412}.viewer-top{height:60px;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;padding:0 3vw;border-bottom:1px solid #ffffff22}.viewer-top .brand{color:#bec7c0;font-size:9px}.viewer-top .brand b{width:25px;height:25px;color:#e2e7e1}.vtitle{display:flex;justify-content:center;gap:17px;color:#d3d8d3;font-size:9px}.vtitle i{color:#839089;font-style:normal}.close{justify-self:end;border:0;background:none;color:#d9ded9;font:300 27px Georgia;cursor:pointer}.stage{height:calc(100dvh - 106px);display:grid;grid-template-columns:66px 1fr 66px;align-items:center;gap:10px;padding:18px 3vw}.spread{display:block;width:100%;height:100%;min-height:0;object-fit:contain}.arrow{width:42px;height:42px;justify-self:center;border:1px solid #ffffff3b;border-radius:50%;background:none;color:white;font-size:16px;cursor:pointer}.arrow:hover{background:#ffffff18}.viewer-bottom{height:46px;display:flex;align-items:center;gap:22px;padding:0 3vw;color:#87918b;font-size:8px;letter-spacing:.1em}.progress{height:1px;flex:1;background:#ffffff2c}.progress i{display:block;width:2.44%;height:1px;background:#d0d8d2;transition:width .2s}
@media(max-width:900px){.nav{padding:0 5vw}.nav nav{gap:20px}.hero{min-height:auto;padding:65px 8vw;gap:5vw}.intro,.projects,.archive{padding-left:8vw;padding-right:8vw}.process{padding-left:8vw;padding-right:8vw}.note{right:8vw}.pages{grid-template-columns:repeat(3,minmax(0,1fr))}.closing-copy{padding-left:12vw}.stamp{width:105px;height:105px;left:-42px}}
@media(max-width:620px){.nav{height:64px;padding:0 20px}.brand{font-size:11px}.nav nav{gap:13px}.nav nav a{font-size:8px}.nav nav a:first-child{display:none}.nav .contact{padding:9px 10px}.hero{display:flex;flex-direction:column;align-items:stretch;padding:54px 22px 60px;gap:34px}.hero h1{margin:27px 0 17px;font-size:clamp(61px,16vw,86px)}.lead{font-size:12px}.actions{gap:15px;flex-wrap:wrap;margin-top:22px}.stats{margin-top:24px;font-size:7px;gap:8px}.hero-art{width:84%;align-self:flex-end;margin-right:7%}.stamp{width:90px;height:90px;left:-35px}.stamp strong{font-size:17px}.intro{grid-template-columns:1fr auto;padding:22px;gap:12px}.intro p{grid-column:1/-1;grid-row:2;font-size:17px}.intro button{grid-column:2;grid-row:1;font-size:8px}.projects,.archive{padding:74px 22px 82px}.heading{display:block;margin-bottom:32px}.heading h2{font-size:49px}.heading>p{margin-top:18px}.grid{grid-template-columns:1fr;gap:38px}.card:nth-child(even){transform:none}.card h3{font-size:27px}.card>p{min-height:0}.process{padding:37px 22px 45px}.steps{grid-template-columns:repeat(2,1fr);gap:25px 18px;margin-top:26px}.steps h3{font-size:22px}.note{position:static;display:block;margin-top:24px}.archive-bar{font-size:8px}.archive-bar button{font-size:8px}.pages{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 10px}.page-caption{gap:7px}.page-caption span{font-size:7px}.closing-copy{padding:86px 23px 100px}.closing h2{font-size:67px}.closing-copy>p:not(.eyebrow){font-size:10px}.o1{width:400px;right:-170px;top:-100px}.o2{width:310px;right:-100px;top:-50px}.o3{width:220px;right:-20px;top:0}.footer{padding:19px 22px;align-items:flex-start;flex-wrap:wrap}.footer p{order:3;width:100%}.footer>div{gap:13px}.viewer-top{grid-template-columns:1fr auto;padding:0 14px}.viewer-top .brand{font-size:8px}.vtitle{position:absolute;top:68px;left:14px;z-index:1;padding:5px 7px;background:#111a;font-size:8px}.stage{grid-template-columns:34px 1fr 34px;gap:2px;padding:10px 6px}.arrow{width:31px;height:31px;font-size:13px}.viewer-bottom{padding:0 13px;gap:12px;font-size:6px}.viewer-bottom>span:last-child{display:none}}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}*,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}}

.additional-work{padding:112px 12.5vw 120px;background:#eeefea}.store-note{display:flex;align-items:center;gap:22px;margin:0 0 42px;padding:20px 24px;border-block:1px solid #cdd2ca}.store-number{font:400 43px Georgia,serif;color:var(--blue)}.store-note p{margin:0;color:#626b64;font-size:10px;line-height:1.8}.store-note b{color:var(--ink);font-size:11px}.additional-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 20px}.additional-card{min-width:0}.additional-image{display:block;position:relative;width:100%;aspect-ratio:1.35/1;overflow:hidden;padding:0;border:0;background:#dfe2dc;cursor:zoom-in}.additional-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s}.additional-image:hover img{transform:scale(1.035)}.additional-image span{position:absolute;bottom:10px;right:10px;padding:7px 9px;background:#f7f6f2e8;color:#202724;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.additional-group{margin:14px 0 7px;color:#79847c;font-size:7px;letter-spacing:.13em;text-transform:uppercase}.additional-card h3{margin:0;font:400 23px Georgia,serif}.additional-meta{margin:5px 0 8px;color:#849087;font-size:8px;letter-spacing:.07em;text-transform:uppercase}.additional-desc{margin:0;color:#737971;font-size:9px;line-height:1.75}.image-viewer{position:fixed;width:min(94vw,1100px);max-width:none;max-height:90dvh;padding:42px 20px 16px;border:1px solid #ffffff24;background:#111615;color:#f7f6f2}.image-viewer::backdrop{background:#101412eF}.selected-image{display:block;max-width:100%;max-height:75dvh;margin:auto;object-fit:contain}.selected-caption{text-align:center;color:#c4ccc5;font-size:10px;letter-spacing:.07em}.image-close{position:absolute;top:8px;right:14px;border:0;background:none;color:#fff;font:300 28px Georgia;cursor:pointer}
@media(max-width:900px){.additional-work{padding-left:8vw;padding-right:8vw}.additional-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.additional-work{padding:74px 22px 82px}.additional-grid{grid-template-columns:1fr;gap:28px}.store-note{gap:14px;padding:16px 0}.store-number{font-size:36px}.store-note p{font-size:9px}}
</style>
<script>
const dialog=document.querySelector(".viewer");
const spread=document.querySelector(".spread");
const title=document.querySelector("#vtitle");
const count=document.querySelector("#vcount");
const bar=document.querySelector(".progress i");
const pageTitles=["Portfolio cover","A note on staying curious","Contact","Guru — product study","Guru — sketches and ideas","Guru — form development","Guru — handle and screen studies","Guru — user context","Guru — research insights","Guru — usage scenarios","Guru — form research","Guru — concept development","Guru — finalization","Guru — interface wireframes","Guru — prototypes","Guru — product catalog","Guru — catalog study","Guru — catalog study","Guru — catalog study","Guru — final catalog","Graduation projects exhibition","Neosteam — steam iron","Neosteam — product analysis","Neosteam — ergonomics and concepts","Neosteam — final concept","T-Express — tea machine","T-Express — design process","T-Express — final features","Monjam — jam jar","Monjam — first phase","Tea brewing set — second phase","Tobogga — two-person sled","Tobogga — making and finalization","Vo Mangal — barbecue set","Vo Mangal — visual identity","Vo Mangal — design process","Vo Mangal — drawings","Graduation poster design","Graduation poster design","Graduation exhibition","Thank you"];
let page=1;
function showPage(n){page=Math.max(1,Math.min(41,n));const id=String(page).padStart(2,"0");spread.src="/images/industrial-design-portfolio/page-"+id+".jpg";spread.alt=pageTitles[page-1]+", page "+page+" of 41";title.firstChild.textContent=pageTitles[page-1]+" ";count.textContent=id+" / 41";bar.style.width=(page/41*100)+"%"}
document.querySelectorAll("[data-open-page]").forEach((button)=>button.addEventListener("click",()=>{showPage(Number(button.dataset.openPage));dialog.showModal();document.body.style.overflow="hidden"}));
document.querySelector(".prev").addEventListener("click",()=>showPage(page-1));
document.querySelector(".next").addEventListener("click",()=>showPage(page+1));
document.querySelector(".close").addEventListener("click",()=>dialog.close());
dialog.addEventListener("close",()=>{document.body.style.overflow=""});
dialog.addEventListener("click",(event)=>{if(event.target===dialog)dialog.close()});
dialog.addEventListener("keydown",(event)=>{if(event.key==="ArrowLeft")showPage(page-1);if(event.key==="ArrowRight")showPage(page+1)});

const imageDialog=document.querySelector(".image-viewer");const imageTarget=document.querySelector(".selected-image");const imageCaption=document.querySelector(".selected-caption");document.querySelectorAll(".additional-image").forEach((button)=>button.addEventListener("click",()=>{imageTarget.src=button.dataset.image;imageTarget.alt=button.dataset.alt;imageCaption.textContent=button.dataset.title;imageDialog.showModal()}));document.querySelector(".image-close").addEventListener("click",()=>imageDialog.close());imageDialog.addEventListener("click",(event)=>{if(event.target===imageDialog)imageDialog.close()});
</script>
